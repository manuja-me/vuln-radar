{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VulnRadar",
  "version": "1.4.0",
  "identifier": "com.vulnradar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "VulnRadar - Web Vulnerability & Security Scanner",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; script-src 'self'; connect-src 'self' ipc: http: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QjVCRTZBNjVCREQ1QTEKUldTaDFiMWxhcjYxOUpidkExYnFhc0dMRUlYR1JQOFNnVjlSUVBQOHcxL2NsMzk4T21sWFBzd2sK",
      "endpoints": [
        "https://github.com/manuja-me/vuln-radar/releases/latest/download/latest.json"
      ]
    }
  }
}
