# Maintainer: manuja-me <https://github.com/manuja-me/vuln-radar>
pkgname=vuln-radar-bin
pkgver=0.7.0
pkgrel=1
pkgdesc="Desktop Web Vulnerability & Security Scanner (pre-compiled binary)"
arch=('x86_64')
url="https://github.com/manuja-me/vuln-radar"
license=('MIT')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'libayatana-appindicator'
    'librsvg'
    'openssl'
    'cairo'
    'glib2'
    'pango'
)
provides=("vuln-radar=${pkgver}")
conflicts=('vuln-radar')
source_x86_64=("${pkgname}-${pkgver}.deb::https://github.com/manuja-me/vuln-radar/releases/download/v${pkgver}/VulnRadar_${pkgver}_amd64.deb")
sha256sums_x86_64=('SKIP')

package() {
    # Extract package contents from Debian archive
    bsdtar -xf "data.tar.xz" -C "${pkgdir}/" 2>/dev/null || \
    bsdtar -xf "data.tar.gz" -C "${pkgdir}/" 2>/dev/null || \
    bsdtar -xf "data.tar.zst" -C "${pkgdir}/"

    # Install license
    install -Dm644 "${pkgdir}/usr/share/doc/vuln-radar/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" 2>/dev/null || true
}
